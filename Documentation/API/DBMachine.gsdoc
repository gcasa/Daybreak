  </head>
  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the DBMachine class
      </heading>
      <class name="DBMachine" super="DBProcessor">
        <declared>DBMachine.h</declared>
        <desc>
          A single-threaded Draco machine with 4 MB RAM, disk,
          keyboard and an 832 by 633 or 1152 by 861 monochrome
          display. Owns a private, writable disk image.
        </desc>
        <method type="uint32_t">
          <sel>beepSerial</sel>
          <desc>
            Return a serial incremented by each guest sound
            request.
          </desc>
        </method>
        <method type="NSData*">
          <sel>cursorData</sel>
          <desc>
            Return the current sixteen-word cursor bitmap in
            host word order.
          </desc>
        </method>
        <method type="DBDisk*">
          <sel>disk</sel>
          <desc>
            Return the borrowed working disk.
          </desc>
        </method>
        <method type="uint64_t">
          <sel>diskReads</sel>
          <desc>
            Return completed disk sector reads.
          </desc>
        </method>
        <method type="uint64_t">
          <sel>diskWrites</sel>
          <desc>
            Return completed disk sector writes.
          </desc>
        </method>
        <method type="NSData*">
          <sel>displayData</sel>
          <desc>
            Return packed monochrome scanlines, most significant
            pixel first.
          </desc>
        </method>
        <method type="BOOL">
          <sel>displayEnabled</sel>
          <desc>
            Return whether the guest has enabled display
            refresh.
          </desc>
        </method>
        <method type="unsigned int">
          <sel>displayHeight</sel>
          <desc>
            Return the configured display height in pixels.
          </desc>
        </method>
        <method type="NSData*">
          <sel>displayRGB</sel>
          <desc>
            Return display pixels as packed RGB bytes for host
            rendering.
          </desc>
        </method>
        <method type="unsigned int">
          <sel>displayWidth</sel>
          <desc>
            Return the configured display width in pixels.
          </desc>
        </method>
        <method type="BOOL">
          <sel>halted</sel>
          <desc>
            Return <code>YES</code> after the guest requests
            shutdown or suspension.
          </desc>
        </method>
        <method type="id">
          <sel>initWithDisk:</sel>
          <arg type="NSString*">path</arg>
          <sel>switches:</sel>
          <arg type="NSString*">switches</arg>
          <desc>
            Load a Draco disk, initialize the IOP, install its
            germ, and enter sBoot. This starts execution at the
            germ; OS readiness depends on guest progress.
          </desc>
        </method>
        <method type="id">
          <sel>initWithDisk:</sel>
          <arg type="NSString*">path</arg>
          <sel>switches:</sel>
          <arg type="NSString*">switches</arg>
          <sel>workingCopy:</sel>
          <arg type="BOOL">working</arg>
          <desc>
            Boot a private Library disk when workingCopy is
            <code>YES</code>; otherwise use an in-memory image
            suitable for isolated tests.
          </desc>
        </method>
        <method type="id">
          <sel>initWithDisk:</sel>
          <arg type="NSString*">path</arg>
          <sel>switches:</sel>
          <arg type="NSString*">switches</arg>
          <sel>workingCopy:</sel>
          <arg type="BOOL">working</arg>
          <sel>largeScreen:</sel>
          <arg type="BOOL">large</arg>
          <desc>
            Configure a Draco small (832x633) or
            <var>large</var> (1152x861) display before boot.
          </desc>
        </method>
        <method type="void">
          <sel>notifyDevice:</sel>
          <arg type="uint16_t">mask</arg>
          <desc>
            Service a notified IOP device. Unknown device masks
            raise DBDeviceError.
          </desc>
        </method>
        <method type="void">
          <sel>releaseKeys</sel>
          <desc>
            Release all keys, for example on focus loss.
          </desc>
        </method>
        <method type="void">
          <sel>runForInstructions:</sel>
          <arg type="uint32_t">count</arg>
          <desc>
            Execute a bounded slice, polling device events and
            process scheduling.
          </desc>
        </method>
        <method type="void">
          <sel>serviceDisk</sel>
          <desc>
            Service pending rigid disk requests.
          </desc>
        </method>
        <method type="void">
          <sel>setKey:</sel>
          <arg type="unsigned int">key</arg>
          <sel>pressed:</sel>
          <arg type="BOOL">pressed</arg>
          <desc>
            Update a Level V keyboard bit (0..143);
            <var>pressed</var> keys are active low.
          </desc>
        </method>
        <method type="void">
          <sel>setMouseX:</sel>
          <arg type="uint16_t">x</arg>
          <sel>y:</sel>
          <arg type="uint16_t">y</arg>
          <desc>
            Update guest mouse coordinates in display pixels.
          </desc>
        </method>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the DBMachine(Devices)
        category
      </heading>
      <category name="Devices" class="DBMachine">
        <declared>DBMachine.h</declared>
        <desc>
          Draco removable media and NetHub Ethernet IOP services.
        </desc>
        <method type="void">
          <sel>ejectFloppyDiscardingChanges:</sel>
          <arg type="BOOL">discard</arg>
          <desc>
            Eject media, refusing unsaved changes unless
            <var>discard</var> is <code>YES</code>.
          </desc>
        </method>
        <method type="DBFloppy*">
          <sel>floppy</sel>
          <desc>
            Return the borrowed current floppy, or
            <code>nil</code> while the drive is empty.
          </desc>
        </method>
        <method type="void">
          <sel>insertFloppy:</sel>
          <arg type="NSString*">path</arg>
          <sel>readOnly:</sel>
          <arg type="BOOL">readOnly</arg>
          <desc>
            Insert IMD/DMK media. Replacement preserves a 500 ms
            door-open interval. Raises DBFloppyError if
            changed media would be discarded; export or eject
            explicitly first. Loading failure leaves the old
            medium in place.
          </desc>
        </method>
        <method type="DBNetwork*">
          <sel>network</sel>
          <desc>
            Return the borrowed transport or <code>nil</code>
            when networking is disabled.
          </desc>
        </method>
        <method type="uint64_t">
          <sel>packetsReceived</sel>
          <desc>
            Return frames delivered to guest receive buffers.
          </desc>
        </method>
        <method type="uint64_t">
          <sel>packetsSent</sel>
          <desc>
            Return accepted outgoing frame count.
          </desc>
        </method>
        <method type="void">
          <sel>pollDevices</sel>
          <desc>
            Poll transport, waiting receive IOCBs and delayed
            media changes. Runs even when the CPU is idle; caller
            must serialize with instruction execution.
          </desc>
        </method>
        <method type="void">
          <sel>serviceFloppy</sel>
          <desc>
            Complete queued floppy controller requests and
            raise client interrupts.
          </desc>
        </method>
        <method type="void">
          <sel>serviceNetwork:</sel>
          <arg type="BOOL">input</arg>
          <desc>
            Process the specified Ethernet input/output
            notification queue.
          </desc>
        </method>
        <method type="void">
          <sel>setHostID:</sel>
          <arg type="NSString*">identifier</arg>
          <desc>
            Set a six-byte unicast Ethernet ID before boot. Twelve
            hexadecimal digits, optionally separated by
            colons or hyphens; invalid IDs raise an exception.
            The default ID preserves the reference ViewPoint
            configuration.
          </desc>
        </method>
        <method type="void">
          <sel>setNetworkHost:</sel>
          <arg type="NSString*">host</arg>
          <sel>port:</sel>
          <arg type="unsigned int">port</arg>
          <desc>
            Connect/reconnect to NetHub;
            <code>nil</code> <var>host</var> disconnects. No
            default connection.
          </desc>
        </method>
      </category>
    </chapter>
  </body>
</gsdoc>
