<?xml version="1.0"?>
<!DOCTYPE gsdoc PUBLIC "-//GNUstep//DTD gsdoc 1.0.4//EN" "http://www.gnustep.org/gsdoc-1_0_4.dtd">
<gsdoc base="DBApplication" stylesheeturl="default-styles.css">
  <head>
    <title>Daybreak desktop interface</title>
    <author name="Daybreak contributors">
    </author>
    <date>Generated at 2026-09-21 UTC</date>
  </head>
  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the DBApplication class
      </heading>
      <class name="DBApplication" super="NSObject">
        <declared>DBApplication.h</declared>
        <desc>
          Application controller. Uses bounded execution
          slices on the UI thread, avoiding races between
          emulation, display refresh and device input.
        </desc>
        <method type="BOOL">
          <sel>application:</sel>
          <arg type="NSApplication*">application</arg>
          <sel>openFile:</sel>
          <arg type="NSString*">path</arg>
          <desc>
            Queue Finder/GNUstep file-open events until the
            workstation UI is ready.
          </desc>
        </method>
        <method type="void">
          <sel>applicationDidFinishLaunching:</sel>
          <arg type="NSNotification*">notification</arg>
          <desc>
            Create the window and menus, then open the queued,
            command-line or last working disk.
          </desc>
        </method>
        <method type="void">
          <sel>applicationDidResignActive:</sel>
          <arg type="NSNotification*">notification</arg>
          <desc>
            Release all guest input when the application loses
            focus.
          </desc>
        </method>
        <method type="NSApplicationTerminateReply">
          <sel>applicationShouldTerminate:</sel>
          <arg type="NSApplication*">application</arg>
          <desc>
            Save the working disk on termination; cancel
            termination if saving fails.
          </desc>
        </method>
        <method type="BOOL">
          <sel>applicationShouldTerminateAfterLastWindowClosed:</sel>
          <arg type="NSApplication*">application</arg>
          <desc>
            Terminate after the emulator window closes.
          </desc>
        </method>
        <method type="void">
          <sel>applyScreenScale</sel>
          <desc>
            Resize the document to the guest resolution times
            the selected scale. Fit the window on the host screen
            and allow scrolling larger displays.
          </desc>
        </method>
        <method type="void">
          <sel>configureNetwork:</sel>
          <arg type="id">sender</arg>
          <desc>
            Configure the NetHub TCP endpoint or disconnect.
          </desc>
        </method>
        <method type="void">
          <sel>ejectFloppy:</sel>
          <arg type="id">sender</arg>
          <desc>
            Eject media, checking unsaved changes.
          </desc>
        </method>
        <method type="void">
          <sel>finishNetworkPanel:</sel>
          <arg type="id">sender</arg>
          <desc>
            Finish the modal NetHub configuration panel using
            the <var>sender</var> tag.
          </desc>
        </method>
        <method type="void">
          <sel>insertFloppy:</sel>
          <arg type="id">sender</arg>
          <desc>
            Choose and insert IMD/DMK media, with an optional
            write-protect switch.
          </desc>
        </method>
        <method type="void">
          <sel>loadDisk:</sel>
          <arg type="NSString*">path</arg>
          <desc>
            Import or resume a Library working disk, replacing
            the machine after loading.
          </desc>
        </method>
        <method type="BOOL">
          <sel>mayDiscardDisk</sel>
          <desc>
            Save the working hard disk and check floppy changes
            before replacing or quitting.
          </desc>
        </method>
        <method type="BOOL">
          <sel>mayDiscardFloppy</sel>
          <desc>
            Check floppy changes before ejecting or replacing
            media.
          </desc>
        </method>
        <method type="void">
          <sel>openConfiguration:</sel>
          <arg type="id">sender</arg>
          <desc>
            Select a property-list machine profile with model,
            disk, germ and display.
          </desc>
        </method>
        <method type="void">
          <sel>openDisk:</sel>
          <arg type="id">sender</arg>
          <desc>
            Offer a disk picker for XDE, ViewPoint or another
            Draco image.
          </desc>
        </method>
        <method type="void">
          <sel>pause:</sel>
          <arg type="id">sender</arg>
          <desc>
            Toggle instruction execution.
          </desc>
        </method>
        <method type="void">
          <sel>refresh</sel>
          <desc>
            Refresh the processor status and framebuffer.
          </desc>
        </method>
        <method type="void">
          <sel>reportException:</sel>
          <arg type="NSException*">exception</arg>
          <desc>
            Stop execution and show the actual
            <var>exception</var>.
          </desc>
        </method>
        <method type="void">
          <sel>saveDisk:</sel>
          <arg type="id">sender</arg>
          <desc>
            Export the working disk to a separate.zdisk image.
          </desc>
        </method>
        <method type="void">
          <sel>saveFloppy:</sel>
          <arg type="id">sender</arg>
          <desc>
            Export a modified floppy as a separate IMD image.
          </desc>
        </method>
        <method type="void">
          <sel>setScreenScale:</sel>
          <arg type="id">sender</arg>
          <desc>
            Select 100, 150 or 200 percent display scale from
            the <var>sender</var> tag and remember it across
            launches. 100 percent is the guest's native size.
          </desc>
        </method>
        <method type="void">
          <sel>step:</sel>
          <arg type="id">sender</arg>
          <desc>
            Execute one instruction while paused.
          </desc>
        </method>
        <method type="void">
          <sel>tick:</sel>
          <arg type="NSTimer*">timer</arg>
          <desc>
            Run one bounded instruction slice and update the
            display/status.
          </desc>
        </method>
        <method type="void">
          <sel>windowDidResignKey:</sel>
          <arg type="NSNotification*">notification</arg>
          <desc>
            Release input when the main window loses key
            status.
          </desc>
        </method>
        <method type="BOOL">
          <sel>windowShouldClose:</sel>
          <arg type="id">sender</arg>
          <desc>
            Route window closing through working-disk saving and
            floppy checks.
          </desc>
        </method>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the DBDisplayView class
      </heading>
      <class name="DBDisplayView" super="NSView">
        <declared>DBApplication.h</declared>
        <desc>
          Display and Level V input surface. Retains its
          machine and releases all guest keys when focus is
          lost. All access occurs on the application thread.
        </desc>
        <method type="void">
          <sel>copy:</sel>
          <arg type="id">sender</arg>
          <desc>
            Export the display to the host clipboard as TIFF.
          </desc>
        </method>
        <method type="void">
          <sel>keyEvent:</sel>
          <arg type="NSEvent*">event</arg>
          <sel>pressed:</sel>
          <arg type="BOOL">pressed</arg>
          <desc>
            Convert a host keyboard <var>event</var> into a
            guest key press or release.
          </desc>
        </method>
        <method type="void">
          <sel>paste:</sel>
          <arg type="id">sender</arg>
          <desc>
            Type supported clipboard characters through the guest
            keyboard.
          </desc>
        </method>
        <method type="void">
          <sel>pasteNext:</sel>
          <arg type="id">sender</arg>
          <desc>
            Send the next queued clipboard character with a
            bounded key pulse.
          </desc>
        </method>
        <method type="void">
          <sel>print:</sel>
          <arg type="id">sender</arg>
          <desc>
            Print the current emulated display using the native
            print panel.
          </desc>
        </method>
        <method type="void">
          <sel>releaseInput</sel>
          <desc>
            Release guest input when the application loses
            focus.
          </desc>
        </method>
        <method type="void">
          <sel>releaseKey:</sel>
          <arg type="NSNumber*">key</arg>
          <desc>
            Release a guest <var>key</var> after a minimum
            pulse visible to the guest scanner.
          </desc>
        </method>
        <method type="void">
          <sel>setMachine:</sel>
          <arg type="DBMachine*">machine</arg>
          <desc>
            Replace the displayed <var>machine</var>, releasing
            keys on the old <var>machine</var>.
          </desc>
        </method>
        <method type="void">
          <sel>updateMouse:</sel>
          <arg type="NSEvent*">event</arg>
          <desc>
            Convert window mouse coordinates into guest display
            coordinates.
          </desc>
        </method>
      </class>
    </chapter>
  </body>
</gsdoc>
